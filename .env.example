# Google Gemini API Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Model Checkpoint Directory (Relative or Absolute Path)
# By default, points to models/checkpoints/civilsum_bart
BART_CHECKPOINT_PATH=models/checkpoints/civilsum_bart

# Model Execution Mode: "fine_tuned" (strict, required by default) or "pretrained_base" (for baseline testing)
MODEL_MODE=fine_tuned

# Application Port and Host (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
